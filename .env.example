# Copy to .env and edit. Nothing here is read in production without being set.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
# Hostnames only - no https://, no trailing slash. Comma-separated.
# On Render the assigned hostname is picked up automatically, so this only
# needs a custom domain.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Postgres is the database this runs on. Point DATABASE_URL at your instance:
DATABASE_URL=postgres://queue_admin:queue_admin@localhost:5432/smartqueue
#
# No Postgres to hand? The repo ships a compose file:
#   docker compose up -d db
# which brings one up on 5432 with exactly the credentials above.
#
# Or set the parts individually instead of DATABASE_URL:
# POSTGRES_DB=smartqueue
# POSTGRES_USER=queue_admin
# POSTGRES_PASSWORD=queue_admin
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
#
# Managed Postgres usually needs TLS. Most hosted URLs carry ?sslmode=require
# already; this forces it either way.
# POSTGRES_SSLMODE=require
# POSTGRES_CONN_MAX_AGE=60
#
# Development only: run against a local SQLite file instead. Refused outright
# when DJANGO_DEBUG=0, because the queue relies on row locking that SQLite
# does not have.
USE_SQLITE=1

# --- Email (password resets) ---
# Any free SMTP account works; this system sends nothing but reset links.
# With nothing set here, mail is printed to the console instead of sent.
# Check whatever you configure with:  python manage.py mailcheck you@example.com
#
# Naming a provider fills in the host and port for you. One of:
#   brevo | mailjet | smtp2go | resend | sendgrid | gmail | outlook
#
# Brevo is the easiest without two-factor authentication: sign up, verify your
# address, then SMTP & API > SMTP for the login and key. 300 emails a day free.
# EMAIL_PROVIDER=brevo
# EMAIL_HOST_USER=the-login-on-the-smtp-page
# EMAIL_HOST_PASSWORD=the-smtp-key
# EMAIL_SENDER=Smart Queue <the-address-you-verified@example.com>
#
# Others, same three lines: smtp2go (1000/month), mailjet (200/day, API key and
# secret), resend (username is literally "resend", password is the API key).
# Gmail needs 2-Step Verification and an app password, not the account password.
#
# Or point at any host by hand, which overrides the preset:
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1      # port 587. For 465 use EMAIL_USE_SSL=1 instead.

# --- Sign in with Google ---
# From Google Cloud console > APIs & Services > Credentials > OAuth client ID
# (type: Web application). Add this redirect URI to the client:
#   http://localhost:8000/accounts/google/callback/
# The button stays hidden until both values are set.
# GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=xxxxxxxx

# --- HTTPS (only read when DJANGO_DEBUG=0) ---
# Sensible production defaults are already on. Turn them off only if the site
# really is served over plain HTTP, or the redirect will loop.
# DJANGO_SSL_REDIRECT=1
# DJANGO_HSTS_SECONDS=2592000
# DJANGO_HSTS_SUBDOMAINS=1
# DJANGO_HSTS_PRELOAD=0
# DJANGO_BEHIND_PROXY=1

# --- First administrator (deployment only) ---
# For hosts with no shell: `manage.py createadmin` reads these, creates the
# account once, and skips if it already exists. Remove the password after the
# first successful sign-in.
# DJANGO_ADMIN_USERNAME=admin
# DJANGO_ADMIN_PASSWORD=a-long-one-you-choose
# DJANGO_ADMIN_EMAIL=you@example.com
